object   CMDS     code=CMDS:0000 _DATA=41d4
object   CMDS2    code=CMDS:1202 _DATA=4450
object   CMDSB    code=CMDS:18be CONST=8f64
object   CAST     code=CAST:0000 _DATA=4592
object   CASTB    code=CAST:1c36
object   TALK     code=TALK:0000 _DATA=4a9a CONST=9052
object   CAST2    code=CAST2:0000 _DATA=4af6 CONST=94f4
object   ZSTATS   code=ZSTATS:0000 CONST=96b4
object   COMSUBS  code=COMSUBS:0000 CONST=99a0 _BSS=a728
object   SHOPPES2 code=SHOPPES2:0000 _DATA=4c1e CONST=9aa8
object   SHOPPE2B code=SHOPPES2:07e2 _DATA=4d66 CONST=9fc2
object   SHOPPES3 code=SHOPPES3:0000 _DATA=4d7e
object   AFONT0   code=FONT:0000
object   FONT     code=FONT:02a2 _DATA=50ea CONST=a010
object   AFONT    code=FONT:0e52 _DATA=520c

# Objects without code or data of their own: the communal variables, which the
# linker allocates after the last _BSS (tools/u5.py, COMMUNALS).
object   VARS

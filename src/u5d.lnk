# u5d.lnk: the link command file. tools/u5link.py links ULTIMA.EXE, the overlays and DATA.OVL
# from this file and the objects alone; it opens no game file and needs no Phoenix file.
#
# It is written in the spirit of the PLINK86plus 2.24 command file Origin linked with
# (docs/MATCHING.md, "Origin's link, reproduced"): the files in the order the linker processes
# them, the overlay areas and their sections, the libraries, the DEFINEs. u5link places
# everything from that by PLINK's rules (its docstring lists them): every code address, every
# DGROUP offset, the library modules and their order, the areas, the overlays' and DATA.OVL's
# headers, the overlay table and stubs, the communal variables. What no rule settles is stated
# here and marked "fact".
# "tools/linkscript.py --check" compares what u5link computes with the original files.
# A '#' starts a comment. A line that ends in target=gog or target=1988 holds for that target
# only (the 1992 patch's assembly, A2322 and AINTRO2, is the gog target's).

# output NAME: the program, as the overlay table names it.
output   ULTIMA.EXE

# define NAME=OTHER: a second name for the place OTHER names (a PLINK DEFINE). The original
# reaches the overworld map through a name of its own for DS:6608 (vars.h); which object
# defined it is not known.
define   D_6608_overworld=D_6608_map

# The processing order (fact). The order the evidence gives (the DGROUP layout, the library
# order): ULTIMA, the overlays, the library, then the other resident objects in address order.
# How Origin's command file got that order with the resident objects in the root is not known
# (in PLINK, files after the last END would make a section of their own; as a second library
# they land in the root after the runtime, but PLINK pulls them breadth first, not in this
# order: docs/MATCHING.md, "Phase C"): here a file after an END belongs to the root again.
#
# file NAME...: objects, build/obj/NAME.OBJ (compiled from src/NAME.c, or assembled from
# src/asm/NAME.ASM), in the root (before the first area, and after an END).
file     ULTIMA

# begin ... end: an overlay area: it starts where the one before it ends (the first where
# the root ends, at the paragraph) and is as large as its largest section.
# section NAME FILE...: an overlay, NAME.OVL, made of the files named, in that order, at its
# area's base. Its number (the stubs pass it to the loader) is its place among the sections.
begin
section  TOWN     TOWN TOWN2
section  MAINOUT  MAINOUT MAINOUTB
section  DUNGEON  DUNGEON DUNGEONB
section  INTRO    INTRO0 INTRO INTRO2 AINTRO2 INTROB AINTRO          target=gog
section  INTRO    INTRO0 INTRO INTRO2 INTROB AINTRO                  target=1988
end
begin
section  FLAMES   AFLAMES
section  NPC      NPC ANPC
section  COMBAT   COMBAT
section  BLCKTHRN BLCKTHRN
section  LOOKOBJ  LOOKOBJ
section  DNGLOOK  DNGLOOK
section  OUTSUBS  OUTSUBS OUTSUBSB
section  SHOPPES  SHOPPES
section  ENDGAME  ENDGAME
end
begin
section  SJOG     SJOG
section  CMDS     CMDS CMDS2 CMDSB
section  CAST     CAST CASTB
section  TALK     TALK
end
begin
section  CAST2    CAST2
section  ZSTATS   ZSTATS
section  COMSUBS  COMSUBS
section  SHOPPES2 SHOPPES2 SHOPPE2B
section  SHOPPES3 SHOPPES3
section  FONT     AFONT0 FONT AFONT
end

# library LIB...: the Microsoft C 5.1 runtime libraries (build/msc51/LIB), searched as one, as
# MSC's setup merges SLIBCR.LIB and LIBH.LIB into SLIBCE.LIB; the modules the search pulls go
# here in the processing order.
library  SLIBCR.LIB LIBH.LIB

file     A0878 LOGO A0DE0 PRINT A1B16 POLLKEY A1B94 WAITKEY A1EAC BACKSPC A2056 USTRLEN A2192
file     DISKSWAP
file     A2322                                                       target=gog
file     SWDISKS FILEIO PARTY COMMANDS WORLD VIEW VISIBLE BATTLE A6F1E LIGHTHSE A71AA

# loader NAME: the overlay loader, OVERLAY.LIB's DUMMY and OVLYV and Origin's OVUSERM, as one
# assembly module (src/asm/PLMGR.ASM). In Origin's link a reference to DUMMY brought it in
# first, so its class (OVLOADER) came before the table's (LOADER); here both are class CODE,
# met in this order. Its data is a segment of its own, OVDATA (as OVERLAY.LIB's), on the
# paragraph after its code.
loader   PLMGR

# table: the overlay table and the call stubs (PLINK's $OVTB$), which u5link makes.
table

# section NAME FILE... after the areas: the pre-loaded section, DGROUP, written to NAME.OVL.
# VARS.OBJ holds nothing (which object Origin put here is not known). The communal variables
# are allocated by the rule (u5link), in COMDEF record order object by object in processing
# order: ultima.c declares the shared ones, each overlay module its own.
section  DATA     VARS

# wrapper NAME stackgap=N sp=N: Origin's copy-protection wrapper (src/asm/PLSTART.ASM), appended
# to the program PLINK wrote; it took the entry point. Its stack (fact): SS stackgap paragraphs
# past the end of the image, SP sp (hexadecimal).
wrapper  PLSTART  stackgap=0100 sp=0064

# stubs NAME...: the functions called from another section, in the order of their call stubs
# in the table (fact). Which functions get one is the rule (u5link checks this list against
# it); PLINK makes them in the order the symbols enter its symbol table (DEFINEs, then each
# file's external and public names in processing order), which here gives each stub's section
# but not the order within one: that is the original objects' record order.
# The lines below start a new line at each turn the rule gives (with u5d's objects): ULTIMA 6,
# TOWN 19, MAINOUT 15, DUNGEON 17, INTRO 5, FLAMES 1, COMBAT 41, BLCKTHRN 2, LOOKOBJ 3, DNGLOOK
# 3, OUTSUBS 1, SHOPPES 14, SJOG 3, CMDS 10, CAST 18, TALK 4, CAST2 1, FONT 1.
stubs    DungeonMainLoop GetWorldSavefile INTRO_0986_Main MainoutEntry
stubs    TownEntry TownMainLoop
stubs    Death Shrine LoadNpcFile TOWN_10da_ShoutBegone
stubs    TOWN_1694_PlaceActors TOWN_0170_SwapDayNightTiles NPC_00d6_PlaceNpcs MoveNpcs
stubs    Capture TOWN_0b82_KlimbCmd TOWN_0958_RaiseAlarm TalkToNpc
stubs    TOWN_09e6_AttackCmd TOWN_0000_CheckNpcKilled TOWN_0052_SetNpcKilled
stubs    TOWN_00b0_DespawnNpc TOWN_011e_FindNpcByActor PlaceNpcActor
stubs    ScheduleSlot
stubs    Falls StepOnPoisonTile StepOnBurningTile
stubs    EnterCmd MonstersTurn SetUpOverworld
stubs    LoadViewChunks PlaceAmuletShards WaitIfActorNear
stubs    MainoutAttackCmd EnterTown MainoutMoveParty
stubs    ShiftChunks IsMovingActor FlyMissile
stubs    Redraw FreeDungeonImages LoadDungeonImages
stubs    ApplyClearedRooms SetUpDungeonFight CombatMainLoop
stubs    PlaceCombatants EndgameMain DrawView
stubs    MarkRoomCleared StepAfterCombat SetUpMonster
stubs    DungeonKlimbCmd Klimb DUNGEON_1d08_Exit DungeonAttackCmd
stubs    BuildWallRing
